DATABASE_URL=postgres://postgres:senha@localhost:5432/banco
JWT_SECRET=defina-um-segredo-forte
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Redis (BullMQ) — fila de e-mail/WhatsApp e agendador dos lembretes.
# No Windows use um container: docker run -d --name kairoon-redis-dev -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

RESEND_API_KEY=
RESEND_FROM=

# WhatsApp transacional (Z-API) — confirmação de agendamento e lembrete de véspera.
# Sem estas variáveis a app sobe normal e os envios viram no-op (só logados).
# INSTANCE_ID e TOKEN vêm da instância no painel Z-API; CLIENT_TOKEN é o
# "Token de Segurança da Conta" (aba Segurança), exigido em todas as chamadas
# depois de ativado lá.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Gateway de pagamento (Asaas) — assinatura dos planos pagos.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Bunny.net Storage — upload de logos, banners e fotos de perfil.
# Endpoint é o host da Storage Zone (Frankfurt/DE = storage.bunnycdn.com).
# Password é a AccessKey de leitura+escrita da Storage Zone (mantenha em segredo, só no backend).
# CDN_URL é o hostname da Pull Zone que serve os arquivos publicamente.
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_CDN_URL=https://sua-zona.b-cdn.net