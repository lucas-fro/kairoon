# Copie para .env na VPS e preencha. Este arquivo alimenta o serviço "backend"
# do docker-compose.yml (env_file: .env). NÃO comitar o .env preenchido.

# Conexão com o Postgres que roda no OUTRO compose, na rede "web".
# O host é o nome do container/serviço do Postgres naquele compose.
# Ex.: se lá o serviço se chama "postgres", use postgres:5432.
DATABASE_URL=postgres://USUARIO:SENHA@NOME_DO_CONTAINER_POSTGRES:5432/agendadb

# Segredo dos tokens JWT — mínimo 20 caracteres. Gere um forte:
#   openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-de-32-bytes

# Origem permitida para CORS. Mesmo com o proxy /api (mesma origem), mantenha
# correto por segurança.
CORS_ORIGIN=https://app.kairoon.com.br

# E-mail transacional (Resend). Opcional em dev; defina em produção.
RESEND_API_KEY=
RESEND_FROM=Kairoon <no-reply@kairoon.com.br>

# Gateway de pagamento (Asaas) — assinatura dos planos pagos.
# ASAAS_ENV=production só em produção real (padrão é sandbox).
# ASAAS_WEBHOOK_TOKEN: mesmo valor configurado no painel Asaas para o webhook.
ASAAS_API_KEY=
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=
